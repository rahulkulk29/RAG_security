# =============================================================================
# RAG Security Testbed: Environment Configuration Template
# Copy this file to .env and configure local environment settings.
# =============================================================================

# --- Environment & Security Configuration ---
# Environment: development, test, or production
ENVIRONMENT=development
# Comma-separated list or JSON array of allowed origins for CORS
# CORS_ALLOWED_ORIGINS=["http://localhost:3000","http://localhost:8000"]

# --- Gemini API Configuration ---
# Required for RAG generation and security evaluation (Milestones 5+)
GEMINI_API_KEY=
# Configurable model ID (unset by default; configured in Milestone 5)
GEMINI_MODEL_ID=

# --- ChromaDB Storage Configuration ---
CHROMA_DB_DIR=data/chromadb
CHROMA_COLLECTION_NAME=rag_knowledge_base

# --- Embedding Model Configuration ---
EMBEDDING_MODEL_NAME=sentence-transformers/all-MiniLM-L6-v2

# --- Document Ingestion & Chunking Configuration ---
# chunk_size_chars: ~500 tokens (approx. 4 chars per token)
CHUNK_SIZE_CHARS=2000
# chunk_overlap_chars: ~75 tokens
CHUNK_OVERLAP_CHARS=300

