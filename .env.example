# RAG Security Configuration Example
# Copy to .env for local customized configuration

# Application Environment (development, test, production)
ENVIRONMENT=development

# Server Configuration
PORT=8000
HOST=0.0.0.0

# ChromaDB Vector Storage
CHROMA_DB_DIR=chromadb
CHROMA_COLLECTION_NAME=rag_security_collection

# Canary Registry Configuration
CANARIES_PATH=data/secrets/canaries.json

# Boundary Limits
MAX_TOP_K=10
DEFAULT_TOP_K=4
MAX_QUERY_LENGTH=2000
MAX_ANSWER_LENGTH=50000

# Optional: Google Gemini API Key (Required ONLY for live evaluation mode: python run_evaluation.py --live)
# GEMINI_API_KEY=your_gemini_api_key_here
